/**
 * Gruvbox Material (Medium) theme
 * Taken from: https://user-images.githubusercontent.com/58662350/213884019-cbcd5f00-5bef-4a37-9139-0570770330b6.png
 * Repository: https://github.com/hiimsergey/rofi-gruvbox-material
 */

* {
    bg0: #282828A0;
    bg1: #32302f;
    grey0: #7c6f64;
    fg0: #d4be98;

    blue: #7daea3;
    red: #ea6962;
    orange: #e78a4e;
    green: #a9b665;
    bgStatusline3: #504945;

    background-color: @bg0;
}

window {
    height: 600;
    width: 600;

    border: 2;
    border-radius: 5;
    border-color: @orange;
}

mainbox {
    spacing: 0;
    children: [inputbar, message, listview, mode-switcher];
}

inputbar {
    color: @fg0;
    padding: 14;
    background-color: @bg0;
    border-radius: 5;         /* Rounds the corners */
    margin: 10 10 10 10;       /* Detaches it from the edges of the window */
}

message {
    padding: 10;
    border-radius: 5;
    background-color: @bg1;
    margin: 0 10 10 10;
}

mode-switcher {
    margin: 0 10 10 10;        /* Detaches from edges and bottom */
    border-radius: 5;
    spacing: 10; /* Adds space between the individual buttons */
    padding: 10; /* Keeps it neatly padded at the bottom */
    background-color: @bg0;
}

button {
    padding: 8;
    border-radius: 5; /* Matches your element rounding */
    background-color: @bg1; /* Unselected tab color */
    background-color: transparent; /* Unselected tab color */
    text-color: @fg0;
    cursor: pointer;
    horizontal-align: 0.5; /* Centers the content horizontally */
    vertical-align: 0.5;   /* Centers the content vertically */
}

button selected {
    background-color: @grey0; /* Highlighted tab color */
    text-color: @fg0;
}

listview {
    margin: 0 10 10 10;        /* Creates a 10px gap on the bottom, left, and right */
    padding: 12 12 12 12;      /* Keeps the scrollbar from overlapping */
    spacing: 8;
    border-radius: 5;          /* Matches the 5px rounding of the search bar */
    border: 0;                 /* Removes the weird outline */
    border-color: @bg0;
    background-color: @bg0;
    dynamic: false;
    scrollbar: true;
}

scrollbar {
    width: 6px;                  /* Thickness of the scrollbar */
    border-radius: 5;
    handle-width: 6px;           /* Makes the handle match the track width */
    handle-color: @grey0;        /* The earthy brown color of the scroll thumb */
    background-color: @bg1;      /* The slightly lighter background for the track */
    padding: 0;
    margin: 0 0 0 3px;          /* Adds a tiny gap between the text and the scrollbar */
}

textbox {
    text-color: @fg0;
    background-color: inherit;
}

error-message {
    border: 20 20 20 20;
}

entry, prompt, case-indicator {
    text-color: inherit;
    background-color: transparent; /* Forces the inner boxes to be invisible */
}

prompt {
    margin: 0 10 0 0;
}

element {
    padding: 8 12;
    vertical-align: 0.5;
    border-radius: 5;
    background-color: transparent;
}

/* Force standard unselected rows to be invisible */
element.normal.normal {
    background-color: transparent; 
}

element.selected.normal {
    background-color: @grey0;
}

element.alternate.normal {
    background-color: transparent;
}

element.normal.active, element.alternate.active {
    background-color: @orange;
}

element.selected.active {
    background-color: @green;
}

element.normal.urgent, element.alternate.urgent {
    background-color: @red;
}

element.selected.urgent {
    background-color: @blue;
}

element-text, element-icon {
    size: 40;
    margin: 0 10 0 0;
    vertical-align: 0.5;
    background-color: inherit;
    text-color: @fg0;
}

element-text .active, element-text .urgent {
    text-color: @bg0;
}
